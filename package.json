{
    "name": "december",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/phasehumans/december"
    },
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "prepare": "husky",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:knip": "knip",
        "lint:spelling": "cspell --no-must-find-files \"**/*.{md,ts,tsx,json}\"",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "dev": "turbo run dev --filter=!@trydecember/cli --filter=!@december/tui 2>&1 | tee -a log.txt",
        "test": "turbo run test",
        "test:unit": "turbo run test:unit",
        "test:integration": "turbo run test:integration",
        "test:load": "turbo run test:load",
        "test:benchmark": "turbo run test:benchmark",
        "test:smoke": "turbo run test:smoke",
        "test:tools": "cd packages/tools && bun test",
        "test:providers": "cd packages/providers && bun test",
        "test:shared": "cd packages/shared && bun test",
        "test:tui": "cd packages/tui && bun test",
        "test:agent": "cd packages/agent && bun test",
        "test:cli": "cd apps/cli && bun test",
        "test:evals": "cd packages/evals && bun test",
        "eval": "cd packages/evals && bun run eval",
        "eval:humaneval": "cd packages/evals && bun run eval:humaneval",
        "eval:mbpp": "cd packages/evals && bun run eval:mbpp",
        "eval:terminalbench": "cd packages/evals && bun run eval:terminalbench",
        "eval:swebench": "cd packages/evals && bun run eval:swebench",
        "clean": "bash scripts/clean.sh",
        "db:generate": "turbo run db:generate",
        "db:migrate": "turbo run db:migrate",
        "db:migrate:dev": "turbo run db:migrate:dev",
        "db:migrate:test": "turbo run db:migrate:test",
        "db:studio": "turbo run db:studio",
        "db:clear": "turbo run db:clear",
        "db:seed:sample": "NODE_PATH=apps/server/node_modules bun scripts/seed-sample-session.ts",
        "docker:start": "bash scripts/container.sh start",
        "docker:stop": "bash scripts/container.sh stop",
        "docker:kill": "docker rm -f $(docker ps -aq --filter \"name=december-preview\")",
        "stop": "tmux kill-session -t december || true",
        "release": "bun scripts/release.ts",
        "dev:cli": "bun run --watch apps/cli/src/index.ts",
        "verify": "bash scripts/verify.sh",
        "reset": "bash scripts/reset.sh",
        "logs": "bash scripts/logs.sh",
        "container": "bash scripts/container.sh"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.58.2",
        "@t3-oss/env-core": "^0.11.1",
        "@types/bun": "latest",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "cspell": "^8.17.5",
        "dotenv": "^17.4.1",
        "eslint": "9",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-boundaries": "^5.0.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "knip": "^5.45.0",
        "lint-staged": "^16.4.0",
        "msw": "^2.7.3",
        "prettier": "^3.8.4",
        "turbo": "2.9.18",
        "typescript-eslint": "^8.59.3",
        "vitest": "^3.0.7",
        "zod": "^3.24.2"
    },
    "overrides": {
        "ioredis": "5.11.1",
        "path-to-regexp": "8.0.0"
    },
    "resolutions": {
        "path-to-regexp": "8.0.0"
    },
    "peerDependencies": {
        "typescript": "^6.0.3"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css,html,yml,yaml}": [
            "prettier --write"
        ]
    },
    "version": "0.3.11",
    "author": "Chaitanya Sonawane",
    "license": "MIT",
    "dependencies": {
        "crelt": "^1.0.7",
        "react": "^19.2.4",
        "style-mod": "^4.1.3",
        "w3c-keyname": "^2.2.8"
    }
}
