[Unit]
Description=December API and WebSocket Server
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/december/apps/server
EnvironmentFile=/var/www/december/.env.production
ExecStart=/usr/local/bin/bun src/server.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
