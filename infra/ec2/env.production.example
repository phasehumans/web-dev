# =================================================================
# December Production Environment Configuration Template
# Place at /var/www/december/.env.production (or use in Docker)
# =================================================================

# Server & Network Configuration
PORT=4000
NODE_ENV=production
WEB_URL=https://app.yourdomain.com
SERVER_URL=https://api.yourdomain.com

# PostgreSQL Database (RDS or Docker)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://december:your_secure_db_password@127.0.0.1:5432/december?schema=public"

# Redis Cache & Queue (ElastiCache or Docker)
REDIS_URL="redis://:your_secure_redis_password@127.0.0.1:6379"

# Encryption & Authentication Secrets
# Generate 64-char hex key via: openssl rand -hex 32
SECRETS_ENC_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ACCESS_TOKEN_SECRET="generate_a_random_jwt_access_secret_key_here"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="generate_a_random_jwt_refresh_secret_key_here"
REFRESH_TOKEN_EXPIRES_IN="30d"
AGENT_TOKEN_SECRET="generate_a_random_agent_token_secret_here"
BCRYPT_SALT_ROUNDS=10

# AWS S3 Object Storage
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY="YOUR_AWS_ACCESS_KEY_ID"
S3_SECRET_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
S3_BUCKET="december-production-storage"
S3_FORCE_PATH_STYLE=false

# Worker E2B Sandboxing
E2B_API_KEY="e2b_your_production_api_key"

# AI Model Provider Keys (Configure as needed)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""

# Email Service (Resend)
RESEND_API_KEY=""
SENDER_EMAIL="noreply@yourdomain.com"

# Payment Gateways (Optional)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_PRO_PLAN_ID=""
RAZORPAY_WEBHOOK_SECRET=""
COINBASE_API_KEY=""
COINBASE_WEBHOOK_SECRET=""

# OAuth Integrations (Optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
