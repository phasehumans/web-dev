{
    "name": "@december/server",
    "version": "0.3.24",
    "module": "server.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --watch src/server.ts",
        "start": "bun src/server.ts",
        "typecheck": "tsc --noEmit",
        "test": "bun run test:unit && bun run test:integration",
        "test:unit": "bunx --bun dotenv-cli -e ../../.env.test -- bun test test/unit",
        "test:integration": "bunx --bun dotenv-cli -e ../../.env.test -- bun test test/integration"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bun": "^1.3.11",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/pino-http": "6.1.0",
        "@types/supertest": "^7.2.0",
        "dotenv-cli": "^11.0.0",
        "supertest": "^7.2.2"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1014.0",
        "@aws-sdk/s3-request-presigner": "3.1086.0",
        "@december/database": "workspace:*",
        "@december/providers": "workspace:*",
        "@december/shared": "workspace:*",
        "@playwright/test": "^1.58.2",
        "@socket.io/redis-adapter": "8.3.0",
        "axios": "^1.16.1",
        "bcrypt": "^6.0.0",
        "bullmq": "5.80.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.1",
        "express": "^5.2.1",
        "express-rate-limit": "8.5.2",
        "google-auth-library": "^10.6.1",
        "helmet": "8.3.0",
        "ioredis": "5.11.1",
        "jsonwebtoken": "^9.0.3",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "rate-limit-redis": "6.0.0",
        "razorpay": "^2.9.6",
        "resend": "^6.9.3",
        "socket.io": "4.8.3",
        "zod": "^4.3.6"
    },
    "author": "Chaitanya Sonawane",
    "license": "MIT"
}
