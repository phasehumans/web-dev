{
    "name": "@december/worker",
    "version": "0.3.6",
    "private": true,
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "bun src/index.ts",
        "build": "echo 'No build required for worker'",
        "typecheck": "tsc --noEmit",
        "test": "dotenv -e ../../.env.test -- bun test",
        "test:unit": "dotenv -e ../../.env.test -- bun test test/unit",
        "test:integration": "dotenv -e ../../.env.test -- bun test test/integration"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1089.0",
        "@aws-sdk/s3-request-presigner": "3.1089.0",
        "@december/agent": "workspace:*",
        "@december/database": "workspace:*",
        "@december/providers": "workspace:*",
        "@december/shared": "workspace:*",
        "@december/tools": "workspace:*",
        "archiver": "8.0.0",
        "bullmq": "^5.0.0",
        "@e2b/sandbox": "npm:e2b@2.37.0",
        "dotenv": "17.4.2",
        "e2b": "2.37.0",
        "ioredis": "^5.0.0",
        "jsonwebtoken": "^9.0.3"
    },
    "devDependencies": {
        "@types/archiver": "8.0.0",
        "@types/bun": "latest",
        "@types/jsonwebtoken": "^9.0.9"
    }
